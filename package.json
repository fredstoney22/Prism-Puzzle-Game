{
	"name": "flip",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@scalar/hono-api-reference": "^0.9.37",
			"better-auth": "^1.4.0",
			"hono": "^4.11.7",
			"zod": "^4.3.6",
			"@hono/zod-openapi": "^1.2.0",
			"drizzle-kit": "^0.31.9",
			"drizzle-orm": "^0.45.1"
		}
	},
	"type": "module",
	"scripts": {
		"db:start": "bash scripts/start-db.sh",
		"db:generate": "npm run generate -w @flip/db",
		"db:migrate": "npm run migrate -w @flip/db",
		"db:push": "npm run push -w @flip/db",
		"db:studio": "npm run studio -w @flip/db",
		"db:seed": "SEED_ACTIVE_MODE=dev npm run seed -w @flip/db",
		"db:seed:all": "SEED_ACTIVE_MODE=all npm run seed -w @flip/db",
		"db:seed:production": "SEED_ACTIVE_MODE=production npm run seed -w @flip/db",
		"api:dev": "npm run dev -w @flip/api",
		"app:dev": "npm run dev -w @flip/app",
		"game:validate": "npx tsx packages/game/scripts/validate-packs.ts",
		"game:generate-pack": "npx tsx packages/game/scripts/generate-pack.ts",
		"game:regenerate-auto-packs": "npx tsx packages/game/scripts/regenerate-auto-packs.ts",
		"game:report-difficulty": "npx tsx packages/game/scripts/report-pack-difficulty.ts",
		"game:report-difficulty-muse": "npx tsx packages/game/scripts/report-pack-difficulty.ts --muse --compare",
		"game:reorder-pack": "npx tsx packages/game/scripts/reorder-pack-by-difficulty.ts",
		"game:report-nullity": "npx tsx packages/game/scripts/report-pack-nullity.ts",
		"game:validate-algebraic-solver": "npx tsx packages/game/scripts/validate-algebraic-solver.ts",
		"lint": "npm run lint -w @flip/app",
		"lint:fix": "npm run lint:fix -w @flip/app",
		"test": "npm run test -w @flip/app",
		"test:ui": "npm run test:ui -w @flip/app",
		"test:puzzle-shell": "npm run test:puzzle-shell -w @flip/app",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"stripe:listen": "stripe listen --forward-to localhost:5173/api/webhooks/stripe",
		"stripe:create-pack-product": "npx tsx apps/api/scripts/create-pack-stripe-product.ts",
		"stripe:setup-paid-packs": "npx tsx apps/api/scripts/setup-paid-pack-products.ts",
		"stripe:setup-webhook": "npx tsx apps/api/scripts/setup-stripe-webhook.ts",
		"stripe:status": "npx tsx apps/api/scripts/stripe-status.ts",
		"stripe:replay-purchases": "npx tsx apps/api/scripts/replay-pack-purchases.ts",
		"stripe:go-live": "npx tsx apps/api/scripts/go-live-stripe.ts",
		"verify:auth": "npx tsx scripts/verify-production-auth.ts",
		"prepare": "husky"
	},
	"devDependencies": {
		"@types/node": "^25.3.0",
		"husky": "^9.1.7",
		"oxfmt": "^0.27.0",
		"oxlint": "^1.42.0",
		"typescript": "^5",
		"vitest": "^3.2.4"
	}
}
